{
  "name": "lucilio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Lucilio — a reflective journal for understanding yourself in a changing world.",
  "scripts": {
    "dev": "concurrently -k -n emu,server,client -c yellow,blue,magenta \"npm:dev:emulators\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:emulators": "node scripts/with-java.mjs firebase emulators:start --only auth,firestore --project lucilio-dev",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.server.build.json && vite build",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "test": "vitest run tests/unit",
    "test:client": "vitest run tests/client",
    "test:watch": "vitest",
    "setup:jdk": "node scripts/install-jdk.mjs",
    "test:rules": "node scripts/run-emulated-tests.mjs tests/rules",
    "test:integration": "node scripts/run-emulated-tests.mjs tests/integration",
    "test:all": "npm run test && npm run test:client && npm run test:rules && npm run test:integration",
    "evals": "tsx evals/run-evals.ts",
    "evals:reflections": "tsx evals/reflections.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "atlas:check": "tsx scripts/atlas-vantage-check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dompurify": "^3.2.4",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "marked": "^15.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
