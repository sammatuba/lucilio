# Dependencies
node_modules/
.tools/

# Build output
dist/

# Local env and secrets — NEVER commit (constitution: no secret in repo)
.env
.env.*

# Firebase / emulator artifacts
.firebase/
*-debug.log
.firebase

# Test artifacts (rules-results.json is regenerated by test:rules and committed)
tests/results/*.tmp

# Editor/OS noise
.DS_Store
*.log
.zcode/
/scripts/onboard-demo.tmp.ts

# migration temp key files (never commit)
lucilio-key.tmp.json
lucilio-key.tmp.txt
webkey.tmp.json
webkey.tmp.txt
firebase-disc.tmp.json
rules-disc.tmp.json

# Local process documents (handover, roadmap, plans, submission sheets): kept on disk, never pushed
docs-local/

# MEOS-REPO:START
# Track the installed contract/runtime; keep session state local.
!/.meos/
/.meos/*
!/.meos/repo.json
!/.meos/runtime.py
!/.meos/lifecycle.md
!/.meos/meos-dsh-update.sh
!/meos
# MEOS-REPO:END

# MEOS-SKILLS:START
